---
import DocsLayout from '@/layouts/DocsLayout.astro';
import DocSection from '@/components/docs/DocSection.astro';
import StaticCode from '@/components/docs/StaticCode.astro';
import PropsTable from '@/components/docs/PropsTable.astro';
import { ThemedDemoCard } from '@/components/demos/ThemedDemoCard';
import { themingVars } from '@/site-data/theming-vars';

const overrideCode = `/* your stylesheet */
.brand-picker {
  --ck-primary: #ec4899;
  --ck-accent: #f43f5e;
  --ck-primary-glow: rgba(236, 72, 153, 0.4);
  --ck-radius: 4px;
  --ck-radius-md: 3px;
  --ck-radius-sm: 2px;
}`;

const applyCode = `<ColorPicker className="brand-picker" />`;

const glassCode = `<ColorPicker className="ck-theme-glass" />`;
---

<DocsLayout slug="theming">
  <Fragment slot="lead">
    ChromaKit is styled with <code>--ck-*</code> CSS custom properties. Set
    them on a class and pass that class through <code>className</code>. No
    build step, no theme prop.
  </Fragment>

  <DocSection
    id="how-it-works"
    title="Override variables on a class"
    description="Define the variables you want to change on a class, then pass that class to the picker. It follows the OS color scheme or a .dark class, so override only what differs."
  >
    <StaticCode code={overrideCode} lang="css" />
    <StaticCode code={applyCode} lang="tsx" />
  </DocSection>

  <DocSection
    id="live"
    title="Live comparison"
    description="The first picker uses the default theme. The second uses the override above: a pink accent and tighter corners."
  >
    <ThemedDemoCard client:visible />
  </DocSection>

  <DocSection
    id="glass"
    title="Glass theme"
    description="Earlier versions shipped a frosted-glass look. Add the ck-theme-glass class to bring back its palette, radii, blur, and shadows."
  >
    <StaticCode code={glassCode} lang="tsx" />
  </DocSection>

  <DocSection
    id="variables"
    title="Available variables"
    description="Defaults shown are the light-theme values; each has a dark-theme counterpart applied under .dark."
  >
    <PropsTable
      rows={themingVars}
      showType={false}
      labels={{ name: 'Variable', default: 'Default (light)' }}
      caption="Theme variables"
    />
  </DocSection>
</DocsLayout>
