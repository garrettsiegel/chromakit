---
import DocsLayout from '@/layouts/DocsLayout.astro';
import DocSection from '@/components/docs/DocSection.astro';
import StaticCode from '@/components/docs/StaticCode.astro';
import PropsTable from '@/components/docs/PropsTable.astro';
import { HookDemoCard } from '@/components/demos/HookDemoCard';
import type { PropRow } from '@/components/docs/props-table-types';

const useColorStateReturn: PropRow[] = [
  { name: 'hsva', type: 'HSVA', description: 'The color as HSVA. Pass it to ColorArea and the sliders.' },
  {
    name: 'colorValue',
    type: 'ColorValue',
    description: 'The color in every format.',
  },
  {
    name: 'updateColor',
    type: '(hsva: HSVA) => void',
    description: 'Set the color from an HSVA value (used by sliders/area).',
  },
  {
    name: 'setFromString',
    type: '(color: string) => ColorValue | null',
    description: 'Parse and set from any color string.',
  },
  {
    name: 'startDrag',
    type: '() => void',
    description: 'Mark a drag as begun (gates onChangeComplete).',
  },
  {
    name: 'endDrag',
    type: '() => void',
    description: 'End a drag; fires onChangeComplete with the final color.',
  },
];

const useColorStateOptions: PropRow[] = [
  {
    name: 'value',
    type: 'string',
    description: 'Controlled color. When set, the hook follows it.',
  },
  {
    name: 'onChange',
    type: '(color: ColorValue) => void',
    description: 'Fires on every change (drag, typing).',
  },
  {
    name: 'onChangeComplete',
    type: '(color: ColorValue) => void',
    description: 'Fires once a drag ends, with the final color.',
  },
];

const useColorStateCode = `const {
  hsva,
  colorValue,
  updateColor,
  setFromString,
  startDrag,
  endDrag,
} = useColorState('#6366F1', {
  onChange: (color) => console.log(color.hex),
});

// colorValue.hex, colorValue.oklch, … are all live`;

const usePointerDragCode = `const { containerRef, handlePointerDown } = usePointerDrag(
  ({ x, y }) => {
    // x, y are 0..1 within the element
  },
  onStart,
  onEnd,
);

<div ref={containerRef} onPointerDown={handlePointerDown} />`;

const useDebounceCode = `const debounced = useDebounce(color, 200);

useEffect(() => {
  save(debounced); // runs 200ms after the last change
}, [debounced]);`;
---

<DocsLayout slug="hooks">
  <Fragment slot="lead">
    <code>useColorState</code> holds the color and returns every setter the
    primitives need. <code>usePointerDrag</code> handles dragging on the color
    area and sliders. <code>useDebounce</code> is deprecated.
  </Fragment>

  <DocSection
    id="use-color-state"
    title="useColorState"
    description="The core state hook. Pass an initial color and an optional options object. It returns the current color in every format, plus the setters that ColorArea, the sliders, and the inputs expect."
  >
    <StaticCode code={useColorStateCode} lang="typescript" />
    <HookDemoCard client:visible />
    <div class="docs-block">
      <h3>Returns</h3>
      <PropsTable
        rows={useColorStateReturn}
        labels={{ name: 'Key', type: 'Type' }}
        showDefault={false}
        caption="useColorState return value"
      />
    </div>
    <div class="docs-block">
      <h3>Options</h3>
      <PropsTable
        rows={useColorStateOptions}
        labels={{ name: 'Option', type: 'Type' }}
        showDefault={false}
        caption="useColorState options"
      />
    </div>
  </DocSection>

  <DocSection
    id="use-pointer-drag"
    title="usePointerDrag"
    description="The drag primitive behind the color area and sliders. It reports coordinates from 0 to 1 and manages the document-level pointer listeners."
  >
    <StaticCode code={usePointerDragCode} lang="typescript" />
  </DocSection>

  <DocSection
    id="use-debounce"
    title="useDebounce (deprecated)"
    description="Deprecated. It will be removed in a future minor release. Debounce in your app instead; the pattern below works with any debounce helper."
  >
    <StaticCode code={useDebounceCode} lang="typescript" />
  </DocSection>
</DocsLayout>
