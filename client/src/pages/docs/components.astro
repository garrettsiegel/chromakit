---
import DocsLayout from '@/layouts/DocsLayout.astro';
import DocSection from '@/components/docs/DocSection.astro';
import PropsTable from '@/components/docs/PropsTable.astro';
import { BuildYourOwnDemoCard } from '@/components/demos/BuildYourOwnDemoCard';
import StaticCode from '@/components/docs/StaticCode.astro';
import { componentGroups } from '@/site-data/components-data';
import { buildYourOwnCode } from '@/site-data/demo-snippets';
---

<DocsLayout slug="components">
  <Fragment slot="lead">
    Need a different layout? Skip <code>ColorPicker</code> and assemble the
    primitives yourself. They share one state object from
    <code>useColorState</code>, so each control needs only two props.
  </Fragment>

  <DocSection
    id="build-your-own"
    split
    title="Build your own picker"
    description="The color area, sliders, inputs, and preview below are separate exports, composed around one useColorState call."
  >
    <BuildYourOwnDemoCard client:visible>
      <StaticCode slot="code" code={buildYourOwnCode} />
    </BuildYourOwnDemoCard>
  </DocSection>

  {
    componentGroups.map((group) => (
      <DocSection
        id={group.id}
        title={group.title}
        description={group.description}
      >
        {group.components.map((component) => (
          <div class="docs-block">
            <h3 class="docs-api-name">{component.name}</h3>
            <p>{component.description}</p>
            <PropsTable
              rows={component.props}
              showDefault={false}
              caption={`${component.name} props`}
            />
          </div>
        ))}
      </DocSection>
    ))
  }
</DocsLayout>
