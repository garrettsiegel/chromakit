---
import DocsLayout from '@/layouts/DocsLayout.astro';
import DocSection from '@/components/docs/DocSection.astro';
import StaticCode from '@/components/docs/StaticCode.astro';
import { BasicDemoCard } from '@/components/demos/BasicDemoCard';
import {
  installCode,
  basicUsageCode,
  nextAppCode,
  nextPagesCode,
  viteCode,
  oklchCode,
} from '@/site-data/getting-started-snippets';

const FRAMEWORKS = [
  {
    title: 'Next.js App Router',
    note: "Mark the component with 'use client'.",
    code: nextAppCode,
  },
  {
    title: 'Next.js Pages Router (SSR)',
    note: 'Load it dynamically with ssr: false.',
    code: nextPagesCode,
  },
  { title: 'Vite / Create React App', note: 'No extra setup.', code: viteCode },
];

const OKLCH_BENEFITS = [
  ['Predictable lightness', 'a given L looks equally bright at every hue.'],
  ['Smoother gradients', 'no muddy middle tones between two colors.'],
  ['Consistent scales', 'generate tonal palettes with uniform visual weight.'],
  ['Beyond sRGB', 'CSS oklch() can describe wide-gamut colors; ChromaKit maps them into sRGB.'],
];

const BROWSERS = [
  ['Chrome / Edge', '88+'],
  ['Firefox', '87+'],
  ['Safari', '15+'],
  ['Node.js (SSR / build)', '20+'],
];
---

<DocsLayout slug="getting-started">
  <Fragment slot="lead">
    ChromaKit is a React color picker and conversion toolkit with zero runtime
    dependencies. It reads and writes OKLCH, OKLAB, HSL, HSV, RGB, and HEX.
    Install the package, import the stylesheet, and render.
  </Fragment>

  <DocSection
    id="installation"
    title="Installation"
    description="The package ships ES module and UMD builds with bundled TypeScript types. React and React DOM 18 or 19 are peer dependencies."
  >
    <StaticCode code={installCode} lang="bash" />
  </DocSection>

  <DocSection
    id="basic-usage"
    split
    title="Basic usage"
    description="Import the component and its stylesheet, then wire it to state. onChange receives a ColorValue with every format pre-converted."
  >
    <BasicDemoCard client:visible>
      <StaticCode slot="code" code={basicUsageCode} />
    </BasicDemoCard>
  </DocSection>

  <DocSection
    id="framework-setup"
    title="Framework setup"
    description="ChromaKit works in any React app. It renders on the client, so server frameworks need the picker loaded client-side."
  >
    {
      FRAMEWORKS.map(({ title, note, code }) => (
        <div class="docs-block">
          <h3>{title}</h3>
          <p>{note}</p>
          <StaticCode code={code} />
        </div>
      ))
    }
  </DocSection>

  <DocSection
    id="why-oklch"
    title="Why OKLCH?"
    description="OKLCH is perceptually uniform — equal numeric changes produce equal visual differences, which HSL cannot promise."
  >
    <ul class="docs-list">
      {
        OKLCH_BENEFITS.map(([term, detail]) => (
          <li>
            <strong>{term}</strong> — {detail}
          </li>
        ))
      }
    </ul>
    <StaticCode code={oklchCode} lang="tsx" />
  </DocSection>

  <DocSection
    id="browser-support"
    title="Browser support"
    description="ChromaKit computes OKLCH in JavaScript, so the browser needs CSS oklch() support only if your app renders that string."
  >
    <div class="props-table-wrap" tabindex="0" role="region" aria-label="Browser support">
      <table>
        <thead>
          <tr><th>Environment</th><th>Minimum version</th></tr>
        </thead>
        <tbody>
          {BROWSERS.map(([name, version]) => (
            <tr><td>{name}</td><td>{version}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </DocSection>
</DocsLayout>
