---
import DocsLayout from '@/layouts/DocsLayout.astro';
import DocSection from '@/components/docs/DocSection.astro';
import StaticCode from '@/components/docs/StaticCode.astro';
import PropsTable from '@/components/docs/PropsTable.astro';
import { ControlledDemoCard } from '@/components/demos/ControlledDemoCard';
import { PresetDemoCard } from '@/components/demos/PresetDemoCard';
import { FormatDemoCard } from '@/components/demos/FormatDemoCard';
import { WideDemoCard } from '@/components/demos/WideDemoCard';
import { colorPickerProps } from '@/site-data/color-picker-props';
import {
  controlledCode,
  presetCode,
  formatCode,
  wideCode,
} from '@/site-data/demo-snippets';

const colorValueCode = `interface ColorValue {
  hex: string;    // "#ff6b6b"
  hex8: string;   // "#ff6b6bff"
  rgb: RGB;       // { r, g, b }
  rgba: RGBA;     // { r, g, b, a }
  hsl: HSL;       // { h, s, l }
  hsla: HSLA;     // { h, s, l, a }
  hsv: HSV;       // { h, s, v }
  hsva: HSVA;     // { h, s, v, a }
  oklab: OKLAB;   // { L, a, b }
  oklch: OKLCH;   // { L, C, h }
  oklcha: OKLCHA; // { L, C, h, a }
}`;
---

<DocsLayout slug="color-picker">
  <Fragment slot="lead">
    The complete picker in one component: color area, hue and alpha sliders,
    format-switchable inputs, presets, recent colors, eyedropper, and copy.
    Turn each part on or off with props.
  </Fragment>

  <DocSection
    id="controlled"
    split
    title="Controlled vs. uncontrolled"
    description="Pass value and onChange for a controlled picker, or defaultValue alone to let ChromaKit manage state. onChange fires on every change; onChangeComplete fires once a drag ends or a swatch is picked."
  >
    <ControlledDemoCard client:visible>
      <StaticCode slot="code" code={controlledCode} />
    </ControlledDemoCard>
  </DocSection>

  <DocSection
    id="props"
    title="Props"
    description="Every prop is optional. Callbacks receive a ColorValue with every format already converted."
  >
    <PropsTable rows={colorPickerProps} />
  </DocSection>

  <DocSection
    id="color-value"
    title="The ColorValue object"
    description="onChange and onChangeComplete both receive this object. Every format is computed up front."
  >
    <StaticCode code={colorValueCode} lang="typescript" />
  </DocSection>

  <DocSection
    id="presets"
    split
    title="Custom presets"
    description="Supply your own swatches with presets, or named groups with presetGroups."
  >
    <PresetDemoCard client:visible>
      <StaticCode slot="code" code={presetCode} />
    </PresetDemoCard>
  </DocSection>

  <DocSection
    id="layouts"
    title="Layouts"
    description='The default compact layout is a 280px column. Pass layout="wide" for a 520px side-by-side version with the color area on the left and a preset-group menu.'
  >
    <WideDemoCard client:visible>
      <StaticCode slot="code" code={wideCode} />
    </WideDemoCard>
  </DocSection>

  <DocSection
    id="format-control"
    split
    title="Format control"
    description="Limit the format dropdown to the formats your app uses."
  >
    <FormatDemoCard client:visible>
      <StaticCode slot="code" code={formatCode} />
    </FormatDemoCard>
  </DocSection>
</DocsLayout>
