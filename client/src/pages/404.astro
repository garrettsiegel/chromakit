---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
---

<BaseLayout
  title="Page Not Found · ChromaKit"
  description="The page you're looking for doesn't exist."
  noindex
>
  <SiteHeader />
  <main id="main-content" class="container not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>Page not found.</h1>
    <p>Nothing lives at this address. Check the URL, or start from the docs.</p>
    <div class="not-found__actions">
      <a href="/">Back to home <span aria-hidden="true">→</span></a>
      <a href="/docs/getting-started">Read the docs <span aria-hidden="true">→</span></a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
