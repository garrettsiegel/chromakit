---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
---

<BaseLayout
  title="Page Not Found · ChromaKit"
  description="The page you're looking for doesn't exist."
  noindex
>
  <SiteHeader />
  <main id="main-content" class="not-found">
    <div class="container not-found__grid">
      <p class="not-found__code" aria-hidden="true">404</p>
      <div>
        <p class="field-label">Outside the available gamut</p>
        <h1>Page not found.</h1>
        <p>The address does not map to a ChromaKit page.</p>
        <div class="not-found__actions">
          <a class="button-primary" href="/">Return to the workbench</a>
          <a class="button-secondary" href="/docs/getting-started">Read the docs</a>
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
