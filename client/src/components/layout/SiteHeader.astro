---
import ThemeToggle from '@/components/ThemeToggle.astro';
import BrandMark from '@/components/BrandMark.astro';

const version = __PKG_VERSION__;
const isDocs = Astro.url.pathname.startsWith('/docs');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand-lockup" aria-label="ChromaKit home">
      <BrandMark />
      <span>ChromaKit</span>
      <span class="brand-lockup__version" aria-label={`Version ${version}`}>
        v{version}
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="site-nav__link" href="/#workbench">Workbench</a>
      <a
        class="site-nav__link site-nav__link--primary"
        href="/docs/getting-started"
        aria-current={isDocs ? 'page' : undefined}
      >
        Read docs <span aria-hidden="true">→</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
