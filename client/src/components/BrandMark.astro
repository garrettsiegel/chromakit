---
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
const id = `ck-mark-${size}`;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 128 128"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-s`} x1="0" x2="1">
      <stop offset="0" stop-color="#fff"></stop>
      <stop offset="1" stop-color="#ff2d20"></stop>
    </linearGradient>
    <linearGradient id={`${id}-v`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000"></stop>
    </linearGradient>
    <linearGradient id={`${id}-h`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f00"></stop>
      <stop offset=".17" stop-color="#ff0"></stop>
      <stop offset=".33" stop-color="#0f0"></stop>
      <stop offset=".5" stop-color="#0ff"></stop>
      <stop offset=".67" stop-color="#00f"></stop>
      <stop offset=".83" stop-color="#f0f"></stop>
      <stop offset="1" stop-color="#f00"></stop>
    </linearGradient>
  </defs>
  <rect width="92" height="128" fill={`url(#${id}-s)`}></rect>
  <rect width="92" height="128" fill={`url(#${id}-v)`}></rect>
  <rect x="102" width="26" height="128" fill={`url(#${id}-h)`}></rect>
  <circle cx="62" cy="34" r="12" fill="none" stroke="#000" stroke-opacity=".45" stroke-width="10"></circle>
  <circle cx="62" cy="34" r="12" fill="none" stroke="#fff" stroke-width="6"></circle>
</svg>
