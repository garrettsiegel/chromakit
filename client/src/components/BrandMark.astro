---
interface Props {
  size?: number;
  class?: string;
}

const { size = 44, class: className } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 128 128"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <rect width="128" height="128" fill="var(--color-paper)"></rect>
  <g fill="none" stroke-width="18" stroke-linecap="butt">
    <path d="M100.77 29.23A52 52 0 0 0 27.23 29.23" stroke="var(--color-chartreuse)"></path>
    <path d="M27.23 29.23A52 52 0 0 0 18.52 80" stroke="var(--color-periwinkle)"></path>
    <path d="M18.52 80A52 52 0 0 0 50.54 113.22" stroke="var(--color-orange)"></path>
    <path d="M50.54 113.22A52 52 0 0 0 100.77 98.77" stroke="var(--color-magenta)"></path>
  </g>
  <path d="M64 64 105 42" fill="none" stroke="var(--color-ink)" stroke-width="4"></path>
  <circle cx="105" cy="42" r="7" fill="var(--color-ink)"></circle>
  <circle cx="64" cy="64" r="5" fill="var(--color-ink)"></circle>
</svg>
