---
import { InstallCommandBox } from '@/components/home/InstallCommandBox';
import BrandMark from '@/components/BrandMark.astro';
---

<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="field-label">React color tools / v{__PKG_VERSION__}</p>
      <h1>Color has structure.</h1>
      <p class="hero-lede">
        ChromaKit is a zero-runtime-dependency picker and conversion toolkit for
        OKLCH, OKLAB, HSL, HSV, RGB, and HEX.
      </p>
      <div class="hero-actions" aria-label="Get started">
        <a class="button-primary" href="#workbench">Try the workbench</a>
        <a class="button-secondary" href="/docs/getting-started">Read the docs</a>
      </div>
      <InstallCommandBox variant="hero" client:load />
    </div>

    <div class="hero-plot" aria-hidden="true">
      <BrandMark size={480} />
      <div class="hero-plot__measure hero-plot__measure--x"></div>
      <div class="hero-plot__measure hero-plot__measure--y"></div>
      <span class="hero-plot__point"></span>
      <p>OKLCH / L 0.94 / C 0.21 / H 114</p>
    </div>
  </div>
</section>
