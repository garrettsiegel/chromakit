---
import { InstallCommandBox } from '@/components/home/InstallCommandBox';
---

<section class="install-section" aria-labelledby="install-title">
  <div class="container install-grid">
    <div>
      <h2 id="install-title">Put the picker to work.</h2>
    </div>
    <div class="install-actions">
      <InstallCommandBox variant="cta" client:visible />
      <div>
        <a class="button-primary" href="/docs/getting-started">Start with the guide</a>
        <a class="button-secondary" href="https://github.com/garrettsiegel/chromakit">Inspect the source</a>
      </div>
    </div>
  </div>
</section>
