---
const FACTS = [
  ['React', '18 and 19 peer support'],
  ['Runtime', '0 package dependencies'],
  ['TypeScript', 'Strict, exported types'],
  ['Spaces', 'OKLCH · OKLAB · HSL · HSV · RGB · HEX'],
  ['Theming', 'Documented --ck-* CSS variables'],
  ['ES bundle', '12.4 kB gzip, measured locally'],
];
---

<section class="facts-section" aria-labelledby="facts-title">
  <div class="container">
    <div class="facts-heading">
      <h2 id="facts-title">Built to join a system, not become one.</h2>
    </div>
    <dl class="facts-grid rule-grid">
      {
        FACTS.map(([term, detail]) => (
          <div>
            <dt>{term}</dt>
            <dd>{detail}</dd>
          </div>
        ))
      }
    </dl>
    <figure class="color-study">
      <picture>
        <source srcset="/brand/color-study-960.avif" type="image/avif" />
        <source srcset="/brand/color-study-960.webp" type="image/webp" />
        <img
          src="/brand/color-study-master.png"
          alt=""
          width="1492"
          height="1054"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption>
        <p>
          Perceptual spaces keep lightness and chroma explicit. ChromaKit keeps
          those values available as data, not decoration.
        </p>
      </figcaption>
    </figure>
  </div>
</section>
