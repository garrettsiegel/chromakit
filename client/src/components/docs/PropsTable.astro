---
import type { PropRow } from '@/components/docs/props-table-types';

interface Props {
  rows: PropRow[];
  labels?: { name?: string; type?: string; default?: string };
  showType?: boolean;
  showDefault?: boolean;
  caption?: string;
}

const {
  rows,
  labels,
  showType = true,
  showDefault = true,
  caption = 'Props',
} = Astro.props;
const empty = '—';
---

<div class="props-table-wrap" tabindex="0" role="region" aria-label={caption}>
  <table>
    <thead>
      <tr>
        <th>{labels?.name ?? 'Prop'}</th>
        {showType && <th>{labels?.type ?? 'Type'}</th>}
        {showDefault && <th>{labels?.default ?? 'Default'}</th>}
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td>
              <code>{row.name}</code>
              {row.required && (
                <span class="props-table__required">
                  *<span class="sr-only"> required</span>
                </span>
              )}
            </td>
            {showType && <td>{row.type ? <code>{row.type}</code> : empty}</td>}
            {showDefault && (
              <td>{row.default ? <code>{row.default}</code> : empty}</td>
            )}
            <td>{row.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
