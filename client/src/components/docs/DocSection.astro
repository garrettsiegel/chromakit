---
interface Props {
  id: string;
  title: string;
  description?: string;
  /** TEXT ON THE LEFT, DEMO ON THE RIGHT (STACKS WHEN NARROW) */
  split?: boolean;
}

const { id, title, description, split = false } = Astro.props;
---

<section
  id={id}
  class:list={['docs-section', { 'docs-section--split': split }]}
>
  {
    split ? (
      <div class="docs-section__text">
        <h2>{title}</h2>
        {description && <p>{description}</p>}
      </div>
    ) : (
      <>
        <h2>{title}</h2>
        {description && <p>{description}</p>}
      </>
    )
  }
  <slot />
</section>
