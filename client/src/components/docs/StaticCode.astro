---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: 'tsx' | 'typescript' | 'bash' | 'css';
}

const { code, lang = 'tsx' } = Astro.props;
---

<div class="code-field">
  <Code
    code={code}
    lang={lang}
    themes={{
      light: 'github-light-high-contrast',
      dark: 'github-dark-high-contrast',
    }}
  />
  <button type="button" class="code-copy" data-copy-code={code}>Copy</button>
</div>

<script>
  import { copyToClipboard } from '@/lib/color-picker';

  // DELEGATED: CODE FIELDS ALSO RENDER LATER INSIDE HYDRATED DEMO TABS
  document.addEventListener('click', async (event) => {
    const button =
      event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>('[data-copy-code]')
        : null;
    if (!button) return;
    const copied = await copyToClipboard(button.dataset.copyCode ?? '');
    button.textContent = copied ? 'Copied' : 'Select code';
    window.setTimeout(() => (button.textContent = 'Copy'), 1500);
  });
</script>
