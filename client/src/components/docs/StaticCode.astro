---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: 'tsx' | 'typescript' | 'bash' | 'css';
}

const { code, lang = 'tsx' } = Astro.props;
---

<div class="code-field not-prose">
  <div>
    <Code code={code} lang={lang} theme="github-dark-high-contrast" />
  </div>
  <button
    type="button"
    class="code-copy"
    data-code={code}
    aria-label="Copy code"
    aria-live="polite"
  >
    Copy
  </button>
</div>

<script>
  document.querySelectorAll('.ck-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') || '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied';
        btn.setAttribute('aria-label', 'Code copied');
        window.setTimeout(() => {
          btn.textContent = 'Copy';
          btn.setAttribute('aria-label', 'Copy code');
        }, 1500);
      } catch {
        btn.textContent = 'Select code';
        btn.setAttribute(
          'aria-label',
          'Clipboard unavailable; select the code manually'
        );
      }
    });
  });
</script>
