---
import '@/index.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = 'https://www.chromakit.site/og-image.png',
  jsonLd = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- APPLY THE SAVED THEME BEFORE FIRST PAINT -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          // LIGHT BY DEFAULT; DARK ONLY WHEN CHOSEN
          const isDark = stored === 'dark';
          // .light STOPS THE PICKER CSS FOLLOWING A DARK OS SCHEME
          document.documentElement.classList.add(isDark ? 'dark' : 'light');
        } catch {
          document.documentElement.classList.add('light');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta
      name="keywords"
      content="react color picker, oklch color picker, oklab, react color picker component, typescript color picker, modern color picker react, customizable color picker, react color picker library, accessible color picker, react component, npm package, color converter, color palette"
    />
    <meta name="author" content="Garrett Siegel" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The ChromaKit picker-glyph logo and wordmark beside a live OKLCH color picker" />
    <meta property="og:site_name" content="ChromaKit" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'SoftwareApplication',
            name: 'ChromaKit',
            applicationCategory: 'DeveloperApplication',
            description:
              'React color picker and conversion toolkit with OKLCH, OKLAB, HSL, HSV, RGB, and HEX. Zero runtime dependencies, TypeScript types, and WCAG contrast helpers.',
            operatingSystem: 'Web Browser',
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
            author: { '@type': 'Person', name: 'Garrett Siegel' },
            license: 'https://opensource.org/licenses/MIT',
            programmingLanguage: 'TypeScript',
            url: 'https://www.chromakit.site/',
            downloadUrl: 'https://www.npmjs.com/package/chromakit-react',
            codeRepository: 'https://github.com/garrettsiegel/chromakit',
          })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <script is:inline>
      (() => {
        let started = false;
        const startAnalytics = () => {
          if (started) return;
          started = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', 'G-8KHB47TJSP');
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-8KHB47TJSP';
          document.head.appendChild(script);
          ['pointerdown', 'keydown', 'touchstart'].forEach((eventName) => {
            window.removeEventListener(eventName, startAnalytics);
          });
        };
        ['pointerdown', 'keydown', 'touchstart'].forEach((eventName) => {
          window.addEventListener(eventName, startAnalytics, { once: true, passive: true });
        });
      })();
    </script>
  </body>
</html>
