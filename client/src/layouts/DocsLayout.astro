---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import DocsNavList from '@/components/docs/DocsNavList.astro';
import { DOCS_NAV } from '@/pages/docs/_nav';
import '@/layouts/docs.css';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const page = DOCS_NAV.find((doc) => doc.slug === slug);
if (!page) throw new Error(`Unknown docs slug: ${slug}`);
---

<BaseLayout
  title={`${page.title} · ChromaKit Docs`}
  description={page.description}
>
  <SiteHeader />
  <div class="container">
    <details class="docs-mobile-nav">
      <summary>
        <span class="field-label">Documentation</span>
        <span>{page.title}</span>
      </summary>
      <nav aria-label="Documentation pages">
        <DocsNavList slug={slug} />
      </nav>
    </details>
    <div class="docs-shell">
      <aside class="docs-rail">
        <nav aria-label="Documentation pages">
          <p class="field-label">Documentation / v{__PKG_VERSION__}</p>
          <DocsNavList slug={slug} />
        </nav>
      </aside>
      <main id="main-content" class="docs-content">
        <header class="docs-intro">
          <h1>{page.title}</h1>
          <p class="docs-lead"><slot name="lead" /></p>
        </header>
        <slot />
      </main>
    </div>
  </div>
  <SiteFooter />
</BaseLayout>
