---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { DOCS_NAV } from '@/pages/docs/_nav';

interface Props {
  slug: string;
  title: string;
  description: string;
}

const { slug, title, description } = Astro.props;
const activePage = DOCS_NAV.find((doc) => doc.slug === slug);
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <details class="docs-mobile-nav">
    <summary>
      <span class="field-label">Documentation</span>
      <span>{activePage?.title ?? 'Browse pages'}</span>
    </summary>
    <nav aria-label="Documentation pages">
      <ul class="docs-nav-list">
        {
          DOCS_NAV.map((doc) => (
            <li>
              <a
                href={`/docs/${doc.slug}`}
                class="docs-nav-link"
                aria-current={doc.slug === slug ? 'page' : undefined}
              >
                {doc.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>
  <div class="docs-shell">
    <aside class="docs-rail">
      <nav aria-label="Documentation pages">
        <p class="field-label">Documentation / v{__PKG_VERSION__}</p>
        <ul class="docs-nav-list">
          {
            DOCS_NAV.map((doc) => (
              <li>
                <a
                  href={`/docs/${doc.slug}`}
                  class="docs-nav-link"
                  aria-current={doc.slug === slug ? 'page' : undefined}
                >
                  {doc.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
    <main id="main-content" class="docs-content">
      <slot />
    </main>
  </div>
  <SiteFooter />
</BaseLayout>
